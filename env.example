# ============================================================================
# ROOT ENV.EXAMPLE - Master template for all environment variables
# ============================================================================
# This file documents ALL environment variables used across the project.
# 
# For actual setup:
# - Backend: Copy to backend/.env and fill in values
# - Frontend: Copy to frontend/.env.local and fill in values
#
# See also:
# - backend/.env.example (backend-specific)
# - frontend/.env.example (frontend-specific)
# ============================================================================

# ============================================================================
# PostgreSQL Database Configuration (REQUIRED - Backend)
# ============================================================================
# Local PostgreSQL connection string format:
# postgresql://[USER]:[PASSWORD]@localhost:5432/[DATABASE]
# Example: postgresql://optiohire_user:optiohire_pass_2024@localhost:5432/optiohire
DATABASE_URL=postgresql://optiohire_user:optiohire_pass_2024@localhost:5432/optiohire
# SSL is not required for local PostgreSQL
DB_SSL=false

# ============================================================================
# Backend Server Configuration
# ============================================================================
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# ============================================================================
# Email Configuration - Backend
# ============================================================================
# Priority: Resend > SendGrid > SMTP

# Resend Email Configuration (Recommended - Domain Verification Support)
USE_RESEND=true
RESEND_API_KEY=your_resend_api_key_here
RESEND_DOMAIN=yourdomain.com
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=OptioHire

# SendGrid Email Configuration (Alternative)
USE_SENDGRID=false
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@optiohire.com
SENDGRID_FROM_NAME=OptioHire

# SMTP Email Configuration (Fallback - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hirebitapplications@gmail.com
SMTP_PASS=your_app_specific_password

# ============================================================================
# IMAP Configuration (for reading emails) - Backend only
# ============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=hirebitapplications@gmail.com
IMAP_PASS=your_app_specific_password
IMAP_SECURE=true
IMAP_POLL_MS=10000
ENABLE_EMAIL_READER=false

# ============================================================================
# AI Configuration (Gemini API) - Backend only
# ============================================================================
# NOTE: Never commit real API keys. Put the real value in backend/.env on the server.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_002=your_gemini_api_key_002
GEMINI_API_KEY_003=your_gemini_api_key_003
REPORT_AI_MODEL=gemini-2.0-flash
SCORING_MODEL=gemini-2.0-flash
RESUME_PARSER_MODEL=gemini-2.0-flash

# ============================================================================
# Webhook Configuration (N8N) - Backend only
# ============================================================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/company-details
N8N_INCOMING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/incoming-data
PUBLIC_API_BASE_URL=http://localhost:3001

# ============================================================================
# Cron/Security Configuration - Backend only
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32
CRON_SECRET=your_cron_secret_key_here

# ============================================================================
# Feature Flags - Backend only
# ============================================================================
DISABLE_REPORT_SCHEDULER=false

# ============================================================================
# Storage Configuration (Optional) - Backend only
# ============================================================================
# For S3-compatible storage (AWS S3, MinIO, etc.):
S3_BUCKET=resumes
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_ENDPOINT=https://your-s3-endpoint.com
S3_REGION=us-east-1
S3_BUCKET_URL=https://your-s3-bucket-url.com/resumes
PDF_BUCKET_URL=https://your-s3-bucket-url.com/resumes
PDF_BUCKET_KEY=your-bucket-key
FILE_STORAGE_DIR=./storage
